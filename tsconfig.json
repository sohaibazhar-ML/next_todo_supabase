{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@/features/*": ["./features/*"],
      "@/components/website/*": ["./components/website/*"],
      "@/components/admin/*": ["./components/admin/*"],
      "@/atoms/*": ["./components/shared/atoms/*"],
      "@/molecules/*": ["./components/shared/molecules/*"],
      "@/organisms/*": ["./components/shared/organisms/*"],
      "@/components/shared/*": ["./components/shared/*"],
      "@/hooks": ["./hooks/shared/index"],
      "@/hooks/*": ["./hooks/shared/*"],
      "@/services": ["./services/shared/index"],
      "@/services/*": ["./services/shared/*"],
      "@/types": ["./types/shared/index"],
      "@/types/*": ["./types/shared/*"],
      "@/constants": ["./constants/shared/index"],
      "@/constants/*": ["./constants/shared/*"],
      "@/utils": ["./utils/shared/index"],
      "@/utils/*": ["./utils/shared/*"],
      "@/icons": ["./components/shared/atoms/AdaptiveIcon/index"],
      "@/icons/*": ["./components/shared/atoms/AdaptiveIcon/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
